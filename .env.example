# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=api_money_saver
HOST=localhost
DB_PORT=5432

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
REFRESH_SECRET=your_refresh_secret_key_here

# Third-Party APIs
GEMINI_API_KEY=your_gemini_api_key_here
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google OAuth (Account Binding)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# --- GOOGLE SSO LOGIN ---
GOOGLE_SSO_CLIENT_ID=your_google_sso_client_id.apps.googleusercontent.com
GOOGLE_SSO_CLIENT_SECRET=your_google_sso_client_secret_here
GOOGLE_SSO_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173